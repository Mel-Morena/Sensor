# 1. IMPORTAÇÃO DAS BIBLIOTECAS

# UART: comunicação serial com o sensor e com o módulo LoRa.
# Pin: configuração e controle dos pinos GPIO.
from machine import UART, Pin

# Biblioteca para controlar os intervalos de tempo.
import time

# Biblioteca para converter bytes em valores numéricos.
import struct


# 2. CONFIGURAÇÃO DO SENSOR RS485

# Pino GP17: transmissão UART do Pico para o RS485.
TX_SENSOR = 17

# Pino GP16: recepção UART do RS485 para o Pico.
RX_SENSOR = 16

# Pino GP18: controla transmissão e recepção do RS485.
RE_DE_PIN = 18

# Inicializa a UART 1 em 9600 bits por segundo.
# TX e RX são os pinos definidos anteriormente.
uart_sensor = UART(
    1,
    baudrate=9600,
    tx=Pin(TX_SENSOR),
    rx=Pin(RX_SENSOR)
)

# Inicializa o controle RE/DE.
# Valor 0 mantém o conversor em modo de recepção.
re_de = Pin(RE_DE_PIN, Pin.OUT, value=0)


# 3. REQUISIÇÃO MODBUS AO SENSOR

# Solicita três registradores do sensor.
# Endereço do dispositivo: 1.
# Função Modbus: 03 (leitura de registradores).
# Registrador inicial: 0000.
# Quantidade de registradores: 0003.
# Os dois últimos bytes são o CRC.
REQUISICAO = bytes([
    0x01, 0x03,
    0x00, 0x00,
    0x00, 0x03,
    0x05, 0xCB
])


# 4. CÁLCULO DO CRC16 MODBUS

def calcular_crc16(dados):

    # Valor inicial padrão do CRC Modbus.
    crc = 0xFFFF

    # Percorre todos os bytes recebidos.
    for byte in dados:

        # Aplica XOR entre o CRC e o byte.
        crc ^= byte

        # Processa os oito bits de cada byte.
        for _ in range(8):

            # Verifica se o bit menos significativo está ligado.
            if crc & 0x0001:

                # Desloca e aplica o polinômio Modbus.
                crc = (crc >> 1) ^ 0xA001

            else:

                # Caso contrário, apenas desloca.
                crc >>= 1

    # Retorna o CRC calculado.
    return crc


# 5. FUNÇÃO DE LEITURA DO SENSOR

def ler_sensor():

    # Descarta dados antigos que estejam no buffer UART.
    if uart_sensor.any():
        uart_sensor.read()

    # Coloca o conversor RS485 em modo de transmissão.
    re_de.value(1)

    # Aguarda o conversor estabilizar.
    time.sleep_ms(2)

    # Envia a requisição Modbus ao sensor.
    uart_sensor.write(REQUISICAO)

    # Aguarda o envio da requisição.
    time.sleep_ms(10)

    # Retorna o conversor ao modo de recepção.
    re_de.value(0)

    # Aguarda a resposta do sensor.
    time.sleep_ms(200)

    # Se não houver dados recebidos, retorna None.
    if not uart_sensor.any():
        return None

    # Lê os bytes disponíveis.
    resposta = uart_sensor.read()

    # Verifica o tamanho e os campos da resposta.
    if (
        len(resposta) != 11
        or resposta[0] != 0x01
        or resposta[1] != 0x03
        or resposta[2] != 0x06
    ):
        return None

    # Calcula o CRC dos bytes, exceto os dois últimos.
    crc_calculado = calcular_crc16(resposta[:-2])

    # Interpreta o CRC recebido em little-endian.
    crc_recebido = struct.unpack('<H', resposta[-2:])[0]

    # Verifica se o CRC calculado corresponde ao recebido.
    if crc_calculado != crc_recebido:
        return None

    # Converte os três registradores recebidos.
    # Umidade: 16 bits sem sinal.
    # Temperatura: 16 bits com sinal.
    # Condutividade: 16 bits sem sinal.
    umidade_bruta, temp_bruta, ec_bruta = struct.unpack(
        '>HhH',
        resposta[3:9]
    )

    # Ajusta a escala da umidade.
    umidade = umidade_bruta / 10.0

    # Ajusta a escala da temperatura.
    temperatura = temp_bruta / 10.0

    # Retorna os valores medidos.
    return umidade, temperatura, ec_bruta


# 6. CONFIGURAÇÃO DO MÓDULO E32-900T20D

# O E32 utiliza UART, não SPI.
# Neste exemplo, utilizamos a UART 0 do Raspberry Pi Pico.

# GP0: transmissão do Pico para RXD do E32.
LORA_TX = 0

# GP1: recepção do Pico a partir do TXD do E32.
LORA_RX = 1

# GP6: controla o pino M0 do módulo.
LORA_M0 = 6

# GP7: controla o pino M1 do módulo.
LORA_M1 = 7

# GP8: monitora o pino AUX do módulo.
LORA_AUX = 8

# Inicializa a UART 0 em 9600 bits por segundo.
# Configuração serial: 8 bits, sem paridade, 1 stop bit.
uart_lora = UART(
    0,
    baudrate=9600,
    bits=8,
    parity=None,
    stop=1,
    tx=Pin(LORA_TX),
    rx=Pin(LORA_RX)
)

# Configura M0 em nível baixo.
m0 = Pin(LORA_M0, Pin.OUT, value=0)

# Configura M1 em nível baixo.
m1 = Pin(LORA_M1, Pin.OUT, value=0)

# Configura AUX como entrada.
aux = Pin(LORA_AUX, Pin.IN)

# M0=0 e M1=0 selecionam o modo normal.
# Nesse modo, o módulo opera com transmissão transparente.


# 7. ESPERA PELO MÓDULO E32

def aguardar_radio(timeout=3000):

    # Marca o início da espera.
    inicio = time.ticks_ms()

    # Aguarda enquanto o módulo estiver ocupado.
    while aux.value() == 0:

        # Verifica se o tempo máximo foi atingido.
        if time.ticks_diff(
            time.ticks_ms(),
            inicio
        ) >= timeout:

            # Informa que o módulo não ficou pronto.
            return False

        # Pequena pausa antes de verificar novamente.
        time.sleep_ms(10)

    # O módulo está disponível.
    return True


# Aguarda a inicialização do módulo após ligar o Pico.
if not aguardar_radio(5000):
    print("Aviso: módulo LoRa não ficou pronto.")

else:
    print("Módulo E32 pronto.")


# 8. IDENTIFICAÇÃO DA ESTAÇÃO E PACOTES

# Identificador único desta estação.
ID_SENSOR = "S01"

# Número sequencial dos pacotes.
sequencia = 0

# Tempo máximo para esperar a confirmação.
TIMEOUT_ACK = 2000

# Número máximo de tentativas de envio.
MAX_TENTATIVAS = 3


# 9. TRANSMISSÃO DOS DADOS E ESPERA PELO ACK

def transmitir_dados(umidade, temperatura, ec, seq):

    # Monta a mensagem com os dados do sensor.
    # Exemplo:
    # DATA;S01;15;45.5;23.2;1250
    mensagem = (
        "DATA;"
        + ID_SENSOR + ";"
        + str(seq) + ";"
        + "{:.1f}".format(umidade) + ";"
        + "{:.1f}".format(temperatura) + ";"
        + str(ec)
        + "\n"
    )

    # Converte a mensagem de texto para bytes.
    pacote = mensagem.encode()

    # Monta o ACK esperado para esta transmissão.
    # Exemplo: ACK;S01;15
    ack_esperado = (
        "ACK;"
        + ID_SENSOR + ";"
        + str(seq)
    )

    # Realiza até três tentativas.
    for tentativa in range(1, MAX_TENTATIVAS + 1):

        # Limpa mensagens anteriores que estejam no buffer.
        if uart_lora.any():
            uart_lora.read()

        # Aguarda o rádio estar livre.
        if not aguardar_radio():

            # Informa que o rádio está ocupado.
            print("Rádio ocupado ou indisponível.")

            # Passa para a próxima tentativa.
            continue

        # Mostra qual tentativa está sendo realizada.
        print(
            "Enviando pacote",
            seq,
            "- tentativa",
            tentativa
        )

        # Envia os dados pelo E32.
        uart_lora.write(pacote)

        # Aguarda o módulo concluir a transmissão.
        if not aguardar_radio():

            # Informa possível falha no envio.
            print("Timeout durante transmissão.")

            # Tenta novamente.
            continue

        # Marca o início da espera pelo ACK.
        inicio = time.ticks_ms()

        # Buffer para acumular a resposta recebida.
        resposta_buffer = b""

        # Aguarda até receber o ACK ou atingir o timeout.
        while time.ticks_diff(
            time.ticks_ms(),
            inicio
        ) < TIMEOUT_ACK:

            # Verifica se há dados recebidos pela UART.
            if uart_lora.any():

                # Lê os bytes disponíveis.
                recebido = uart_lora.read()

                # Acrescenta os bytes ao buffer.
                if recebido:
                    resposta_buffer += recebido

                # Converte a resposta acumulada em texto.
                resposta_texto = resposta_buffer.decode(
                    "utf-8",
                    "ignore"
                )

                # Verifica se o ACK esperado chegou.
                if ack_esperado in resposta_texto:

                    # Mostra a confirmação recebida.
                    print("ACK recebido:", ack_esperado)

                    # Retorna True: pacote confirmado.
                    return True

            # Pequeno intervalo entre verificações.
            time.sleep_ms(20)

        # Se o tempo terminou sem ACK, informa a falha.
        print("Timeout: ACK não recebido.")

    # Se todas as tentativas falharem, retorna False.
    return False


# 10. PROGRAMA PRINCIPAL

while True:

    # Realiza a leitura do sensor.
    dados = ler_sensor()

    # Verifica se a leitura foi válida.
    if dados is not None:

        # Separa os valores recebidos.
        umidade, temperatura, condutividade = dados

        # Mostra os resultados no console.
        print("------------------------------")

        print(
            "Umidade:",
            "{:.1f}%".format(umidade)
        )

        print(
            "Temperatura:",
            "{:.1f} C".format(temperatura)
        )

        print(
            "Condutividade:",
            condutividade,
            "uS/cm"
        )

        # Transmite os valores ao gateway pelo E32.
        confirmado = transmitir_dados(
            umidade,
            temperatura,
            condutividade,
            sequencia
        )

        # Verifica se o gateway confirmou o recebimento.
        if confirmado:

            # Informa que a transmissão foi confirmada.
            print("Transmissão confirmada.")

        else:

            # Informa que não houve confirmação.
            print("Falha na confirmação da transmissão.")

        # Incrementa a sequência do próximo pacote.
        sequencia += 1

        # Limita a sequência a 16 bits.
        # Após 65535, retorna para zero.
        sequencia %= 65536

    else:

        # Informa falha na leitura do sensor.
        print(
            "Falha na leitura "
            "(sem resposta ou pacote corrompido)."
        )

    # Aguarda cinco segundos até a próxima leitura.
    time.sleep(5)
