# Importa as classes UART (comunicação serial) e Pin (controle de pinos I/O) da biblioteca nativa da placa
from machine import UART, Pin
# Importa a biblioteca de tempo para criar atrasos (delays) na execução
import time
# Importa a biblioteca struct para manipulação de dados binários (embora não esteja sendo usada neste código)
import struct

# Define o pino 17 para transmissão de dados (TX)
TX_PIN = 17
# Define o pino 16 para recepção de dados (RX)
RX_PIN = 16 
# Define o pino 18 para controle de fluxo do módulo RS485 (RE/DE - Receive Enable / Data Enable)
RE_DE_PIN = 18 

# Inicializa a porta serial UART 1 com velocidade de 9600 baud rate, usando os pinos definidos
uart = UART(1, baudrate=9600, tx=TX_PIN, rx=RX_PIN)

# Configura o pino RE/DE como um pino de saída digital
re_de = Pin(RE_DE_PIN, Pin.OUT)
# Define o estado inicial do pino como 0 (nível lógico baixo), colocando o RS485 em modo de RECEPÇÃO (escuta)
re_de.value(0)

# Cria uma sequência de 8 bytes que representa a solicitação enviada ao sensor pelo protocolo Modbus RTU.
# 0x01 = endereço do sensor.
# 0x03 = função de leitura de registradores.
# 0x00, 0x00 = endereço inicial dos registradores.
# 0x00, 0x03 = quantidade de registradores a serem lidos (3).
# 0x05, 0xCB = CRC, utilizado para verificar a integridade da mensagem.
parametros = bytes([0x01, 0x03, 0x00, 0x00, 0x00, 0x03, 0x05, 0xCB])

# Define a função principal que fará a leitura e processamento dos dados
def ler_dados():
    # Coloca o pino RE/DE em 1 (nível alto), ativando o modo de TRANSMISSÃO do módulo RS485
    re_de.value(1) 
    # Aguarda 2 milissegundos para estabilizar o barramento antes de enviar
    time.sleep_ms(2)
    # Envia a requisição (os bytes definidos acima) para o sensor via porta serial
    uart.write(parametros)
    # Aguarda 15 milissegundos para dar tempo de todos os bytes serem transmitidos fisicamente
    time.sleep_ms(15)
    # Retorna o pino RE/DE para 0 (nível baixo), voltando o RS485 para o modo de RECEPÇÃO para aguardar a resposta
    re_de.value(0) 
    
    # Aguarda 200 milissegundos para dar tempo ao sensor de processar o comando e enviar a resposta
    time.sleep_ms(200)
    
    # Verifica se há algum dado disponível no buffer de recepção da UART
    if uart.any():
        # Lê todos os bytes retornados pelo sensor e guarda na variável 'resposta'
        resposta = uart.read()

        # Verifica se a resposta contém exatamente 11 bytes (tamanho esperado para a resposta de 3 registradores via Modbus)
        if len(resposta) == 11:

            # Junta o 4º (índice 3) e o 5º (índice 4) bytes para formar o valor inteiro bruto da umidade
            humidade_bruta = (resposta[3] << 8) | resposta[4]
            # Junta o 6º (índice 5) e o 7º (índice 6) bytes para formar o valor inteiro bruto da temperatura
            temperatura_bruta = (resposta[5] << 8) | resposta[6]
            # Junta o 8º (índice 7) e o 9º (índice 8) bytes para formar o valor inteiro bruto da condutividade
            condutividade_bruta = (resposta[7] << 8) | resposta[8]
            
            # Divide a umidade por 10 (conforme o datasheet do sensor) para obter o valor real com casa decimal
            humidade = humidade_bruta / 10.0
            # Divide a temperatura por 10 para obter o valor real em Graus Celsius
            temperatura = temperatura_bruta / 10.0
            # A condutividade não precisa de divisão, o valor bruto é o valor real
            condutividade = condutividade_bruta 
            
            # Imprime o valor da umidade formatado
            print(f"Humidade: {humidade}%")
            # Imprime o valor da temperatura formatado
            print(f"Temperatura: {temperatura}°C")
            # Imprime o valor da condutividade formatado
            print(f"Condutividade: {condutividade} us/cm")
            # Imprime uma linha pontilhada para separar visualmente as leituras no terminal
            print("-" * 20)
        else:
            # Caso os dados recebidos não tenham 11 bytes, avisa que ocorreu um erro/ruído na comunicação
            print("Resposta incompleta recebida do sensor.")
    else:
        # Caso nenhum dado tenha sido recebido na porta serial após o tempo de espera
        print("Sem resposta do sensor.")

# Cria um loop infinito para manter o programa rodando continuamente
while True:
    # Chama a função que criamos para ler os dados do sensor
    ler_dados() 
    # Aguarda 5 segundos antes de repetir o ciclo e fazer uma nova leitura
    time.sleep(5)
